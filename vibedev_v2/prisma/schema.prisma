// filepath: /prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & SYSTEM AUTHENTICATION MODELS
// ==========================================

enum UserRole {
  ADMIN
  USER
  PREMIUM_USER
}

model User {
  id            String        @id @default(cuid()) @map("_id")
  name          String?
  email         String        @unique
  emailVerified DateTime?     @map("email_verified")
  image         String?
  role          UserRole      @default(USER)
  accounts      Account[]
  playgrounds   Playground[]
  myPlayground  StarMark[]
  chatMessages  ChatMessage[]
  activityLogs  ActivityLog[]

  orgMembers    OrgMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ==========================================
// CORE WORKSPACE ENGINE & FILE STRUCTURE
// ==========================================

enum Templates {
  REACT
  NEXTJS
  EXPRESS
  VUE
  HONO
  ANGULAR
}

enum SpaceType {
  PERSONAL
  ORGANIZATION
}

model Playground {
  id             String    @id @default(cuid()) @map("_id")
  title          String
  description    String?
  template       Templates @default(REACT)
  spaceType      SpaceType @default(PERSONAL) @map("space_type") // 🚀 ISOLATION LAYER BOUNDARY
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  templateFiles TemplateFile[]
  Starmark      StarMark[]

  repositoryMap RepositoryMap?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TemplateFile {
  id           String @id @default(cuid()) @map("_id")
  playgroundId String @map("playground_id")

  playground Playground @relation(fields: [playgroundId], references: [id], onDelete: Cascade)

  name     String
  path     String
  content  String  @default("")
  isFolder Boolean @default(false)

  parentId String?       @map("parent_id")
  parent   TemplateFile? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children TemplateFile[] @relation("FolderHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playgroundId])
  @@index([parentId])
}

model StarMark {
  id           String   @id @default(cuid()) @map("_id")
  userId       String
  playgroundId String
  isMarked     Boolean
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playground Playground @relation(fields: [playgroundId], references: [id], onDelete: Cascade)

  @@unique([userId, playgroundId])
}

// ==========================================
// AI CORE FEATURES UTILITY CHANNELS
// ==========================================

model ChatMessage {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  role      String 
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIChatSession {
  id           String      @id @default(cuid()) @map("_id")
  userId       String      @map("user_id")
  playgroundId String      @map("playground_id")
  title        String      @default("New AI Consultation Thread")
  mode         String      @default("chat")
  messages     DbMessage[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([playgroundId])
}

model DbMessage {
  id          String         @id @default(cuid()) @map("_id")
  sessionId   String         @map("session_id")
  session     AIChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String 
  content     String
  type        String         @default("chat")
  modelUsed   String?        @map("model_used")
  tokensUsed  Int?           @map("tokens_used")
  attachments DbAttachment[]
  suggestions DbSuggestion[]
  createdAt   DateTime       @default(now())
}

model DbAttachment {
  id        String    @id @default(cuid()) @map("_id")
  messageId String    @map("message_id")
  message   DbMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  path      String?
  content   String
  language  String
  size      Int
}

model DbSuggestion {
  id           String    @id @default(cuid()) @map("_id")
  messageId    String    @map("message_id")
  message      DbMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  title        String
  description  String
  code         String
  language     String
  category     String
  confidence   Float?
  fileName     String?
  insertLine   Int?
  insertColumn Int?
}

// ==========================================
// EXTENDED VISUALIZER DATA ARCHITECTURE
// ==========================================

model RepositoryMap {
  id           String     @id @default(cuid()) @map("_id")
  playgroundId String     @unique @map("playground_id")
  playground   Playground @relation(fields: [playgroundId], references: [id], onDelete: Cascade)

  // 🚀 Added missing dynamic routing fields
  ownerName      String   @default("") @map("owner_name")
  repositoryName String   @default("") @map("repository_name")
  githubToken    String?  @map("github_token")

  nodes        Json
  edges        Json
  summaries    Json?
  status       String     @default("PENDING")
  lastAnalyzed DateTime   @default(now())
}

// ==========================================
// WORKSPACE MULTI-TENANCY & TEAM MODELS
// ==========================================

model Organization {
  id           String        @id @default(cuid()) @map("_id")
  name         String
  slug         String        @unique
  imageUrl     String?
  ownerId      String        @map("owner_id")
  
  members      OrgMember[]
  playgrounds  Playground[] 
  activityLogs ActivityLog[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("organizations")
}

model OrgMember {
  id             String       @id @default(cuid()) @map("_id")
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String       @default("MEMBER")
  githubUsername String?      @map("github_username") // 🚀 Added for Git Blame parsing integrations

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_members")
}

// ==========================================
// PLATFORM ACTIVITY LOGS / CHANGELOG MODEL
// ==========================================

model ActivityLog {
  id             String        @id @default(cuid()) @map("_id")
  title          String
  description    String
  type           String        
  
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("activity_logs")
}